{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPmzhMgRVimfRX5VoIWVl13"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":10,"metadata":{"id":"CIOS2LfxmCND","executionInfo":{"status":"ok","timestamp":1780123525702,"user_tz":-330,"elapsed":27153,"user":{"displayName":"Suggula Sri Vishnupriya","userId":"18192729581112984130"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"6c892e45-2b71-4eb6-a655-e8e05a8fe46c"},"outputs":[{"output_type":"stream","name":"stdout","text":["DISASTER MANAGEMENT SYSTEM\n","\n","PEAS MODEL\n","Performance Measure : Efficient Resource Distribution\n","Environment         : Disaster Affected Areas\n","Actuators           : Allocate Resources\n","Sensors             : User Input (Disaster + Area Data)\n","\n","Enter Disaster Type (Flood/Earthquake/etc): flood\n","\n","--- Disaster Information Collected ---\n","Disaster Type: flood\n","\n","Enter number of affected areas: 1\n","\n","--- Enter Details for Area 1 ---\n","Enter Area ID: 12\n","Enter Area Name: 1234\n","Number of People Affected: 100\n","Severity (1-Low, 2-Medium, 3-High): 1\n","\n","Enter Needs Assessment\n","Is Food Required? (yes/no): yes\n","Enter Food Quantity: 1000\n","Is Water Required? (yes/no): no\n","Is Medicine Required? (yes/no): no\n","\n","State Added Successfully!\n","\n","\n","===== ALL AREA STATES =====\n","\n","AreaState(area_id='12', name='1234', people=100, severity=1, food_need=1000, water_need=0, medicine_need=0)\n","\n","VISITED AREA IDs: {'12'}\n","\n","AGENT REASONING PROCESS\n","\n","Checking Area: 1234\n","Result : Low Priority\n","\n"]}],"source":["# CO1 - Intelligent Agent Based Disaster Information & Needs Assessment\n","\n","from dataclasses import dataclass\n","\n","# =========================\n","# STATE REPRESENTATION\n","# =========================\n","@dataclass\n","class AreaState:\n","    area_id: str\n","    name: str\n","    people: int\n","    severity: int\n","    food_need: int\n","    water_need: int\n","    medicine_need: int\n","\n","\n","# =========================\n","# FUNCTION\n","# =========================\n","def get_data():\n","\n","    print(\"DISASTER MANAGEMENT SYSTEM\\n\")\n","\n","    # PEAS MODEL\n","    print(\"PEAS MODEL\")\n","    print(\"Performance Measure : Efficient Resource Distribution\")\n","    print(\"Environment         : Disaster Affected Areas\")\n","    print(\"Actuators           : Allocate Resources\")\n","    print(\"Sensors             : User Input (Disaster + Area Data)\\n\")\n","\n","    # Disaster Info\n","    disaster_type = input(\"Enter Disaster Type (Flood/Earthquake/etc): \")\n","\n","    print(\"\\n--- Disaster Information Collected ---\")\n","    print(\"Disaster Type:\", disaster_type)\n","\n","    areas = []\n","    visited = set()\n","\n","    n = int(input(\"\\nEnter number of affected areas: \"))\n","\n","    for i in range(n):\n","        print(f\"\\n--- Enter Details for Area {i+1} ---\")\n","\n","        area_id = input(\"Enter Area ID: \")\n","        name = input(\"Enter Area Name: \")\n","        people = int(input(\"Number of People Affected: \"))\n","        severity = int(input(\"Severity (1-Low, 2-Medium, 3-High): \"))\n","\n","        print(\"\\nEnter Needs Assessment\")\n","\n","        # Food\n","        food_choice = input(\"Is Food Required? (yes/no): \").lower()\n","        if food_choice == \"yes\":\n","            food = int(input(\"Enter Food Quantity: \"))\n","        else:\n","            food = 0\n","\n","        # Water\n","        water_choice = input(\"Is Water Required? (yes/no): \").lower()\n","        if water_choice == \"yes\":\n","            water = int(input(\"Enter Water Quantity: \"))\n","        else:\n","            water = 0\n","\n","        # Medicine\n","        medicine_choice = input(\"Is Medicine Required? (yes/no): \").lower()\n","        if medicine_choice == \"yes\":\n","            medicine = int(input(\"Enter Medicine Quantity: \"))\n","        else:\n","            medicine = 0\n","\n","        # Create state\n","        state = AreaState(area_id, name, people, severity, food, water, medicine)\n","\n","        areas.append(state)\n","        visited.add(area_id)\n","\n","        print(\"\\nState Added Successfully!\\n\")\n","\n","    # Display\n","    print(\"\\n===== ALL AREA STATES =====\\n\")\n","\n","    for area in areas:\n","        print(area)\n","\n","    print(\"\\nVISITED AREA IDs:\", visited)\n","\n","    # Reasoning\n","    print(\"\\nAGENT REASONING PROCESS\\n\")\n","\n","    for area in areas:\n","        print(\"Checking Area:\", area.name)\n","\n","        if area.severity == 3 or area.people > 5000:\n","            print(\"Result : High Priority\\n\")\n","        elif area.severity == 2:\n","            print(\"Result : Medium Priority\\n\")\n","        else:\n","            print(\"Result : Low Priority\\n\")\n","\n","    return disaster_type, areas\n","\n","\n","# =========================\n","# CALL FUNCTION (IMPORTANT)\n","# =========================\n","disaster_type, areas = get_data()"]},{"cell_type":"code","source":["# CO2 - Priority Calculation using Greedy Search\n","\n","# =========================\n","# PRIORITY FUNCTION\n","# =========================\n","def calculate_priority(area, disaster):\n","\n","    print(f\"\\nCalculating Priority for {area.name}\")\n","\n","    severity_score = 0.4 * area.severity\n","    people_score = 0.3 * (area.people / 100)\n","    needs_score = 0.3 * ((area.food_need + area.water_need + area.medicine_need) / 100)\n","\n","    print(\"Severity Contribution :\", severity_score)\n","    print(\"People Contribution   :\", people_score)\n","    print(\"Needs Contribution    :\", needs_score)\n","\n","    total_score = severity_score + people_score + needs_score\n","\n","    if disaster.lower() == \"flood\":\n","        print(\"Extra weight for Water (Flood case)\")\n","        total_score += area.water_need * 0.01\n","\n","    elif disaster.lower() == \"earthquake\":\n","        print(\"Extra weight for Medicine (Earthquake case)\")\n","        total_score += area.medicine_need * 0.01\n","\n","    final_score = round(total_score, 2)\n","\n","    print(\"Final Score :\", final_score)\n","\n","    return final_score\n","\n","\n","# =========================\n","# GREEDY SEARCH FUNCTION\n","# =========================\n","def greedy_search(areas, disaster_type):\n","\n","    print(\"\\nCO2 - GREEDY SEARCH (PRIORITY ORDER)\\n\")\n","\n","    if not areas:\n","        print(\"No areas available\")\n","        return []\n","\n","    priority_list = []\n","\n","    for area in areas:\n","        score = calculate_priority(area, disaster_type)\n","        priority_list.append((area, score))\n","\n","    priority_list.sort(key=lambda x: x[1], reverse=True)\n","\n","    print(\"\\n===== FINAL PRIORITY ORDER =====\\n\")\n","\n","    for i, (area, score) in enumerate(priority_list, 1):\n","        print(f\"{i}. {area.name} → Score: {score}\")\n","\n","    print(\"\\nGREEDY SELECTION EXPLANATION\\n\")\n","\n","    for area, score in priority_list:\n","        print(f\"{area.name} selected based on higher priority\")\n","\n","    sorted_areas = [item[0] for item in priority_list]\n","\n","    return sorted_areas\n","\n","try:\n","    sorted_areas = greedy_search(areas, disaster_type)\n","except:\n","    print(\"ERROR: Please run CO1 cell first to generate data!\")"],"metadata":{"id":"z2gDUcM7mYoQ","executionInfo":{"status":"ok","timestamp":1780123686475,"user_tz":-330,"elapsed":21,"user":{"displayName":"Suggula Sri Vishnupriya","userId":"18192729581112984130"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"8635829e-d1f2-41a6-9816-2416af0028d4"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Running CO2...\n","\n","\n","CO2 - GREEDY SEARCH (PRIORITY ORDER)\n","\n","\n","Calculating Priority for 1234\n","Severity Contribution : 0.4\n","People Contribution   : 0.3\n","Needs Contribution    : 3.0\n","Extra weight for Water (Flood case)\n","Final Score : 3.7\n","\n","===== FINAL PRIORITY ORDER =====\n","\n","1. 1234 → Score: 3.7\n","\n","GREEDY SELECTION EXPLANATION\n","\n","1234 selected based on higher priority\n"]}]},{"cell_type":"code","source":["# CO3 - Resource Allocation using Constraints\n","\n","# =========================\n","# RESOURCE ALLOCATION FUNCTION\n","# =========================\n","def allocate_resources(sorted_areas):\n","\n","    print(\"\\n==============================\")\n","    print(\"CO3 - RESOURCE ALLOCATION\")\n","    print(\"==============================\\n\")\n","\n","    # Safety check\n","    if 'sorted_areas' not in globals() or not sorted_areas:\n","        print(\"ERROR: No data received from CO2\")\n","        return\n","\n","    # Input total available resources\n","    total_food = int(input(\"Enter Total Food Available: \"))\n","    total_water = int(input(\"Enter Total Water Available: \"))\n","    total_medicine = int(input(\"Enter Total Medicine Available: \"))\n","\n","    print(\"\\n--- Starting Allocation Process ---\\n\")\n","\n","    # Allocation process (based on priority order from CO2)\n","    for area in sorted_areas:\n","\n","        print(f\"\\nAllocating resources to: {area.name}\")\n","\n","        # FOOD allocation\n","        if total_food >= area.food_need:\n","            food_alloc = area.food_need\n","        else:\n","            food_alloc = total_food\n","        total_food -= food_alloc\n","\n","        # WATER allocation\n","        if total_water >= area.water_need:\n","            water_alloc = area.water_need\n","        else:\n","            water_alloc = total_water\n","        total_water -= water_alloc\n","\n","        # MEDICINE allocation\n","        if total_medicine >= area.medicine_need:\n","            med_alloc = area.medicine_need\n","        else:\n","            med_alloc = total_medicine\n","        total_medicine -= med_alloc\n","\n","        # Output result\n","        print(\"Food Allocated     :\", food_alloc)\n","        print(\"Water Allocated    :\", water_alloc)\n","        print(\"Medicine Allocated :\", med_alloc)\n","        print(\"----------------------------------\")\n","\n","    # Remaining resources\n","    print(\"\\n==============================\")\n","    print(\"FINAL REMAINING RESOURCES\")\n","    print(\"==============================\")\n","    print(\"Food Left     :\", total_food)\n","    print(\"Water Left    :\", total_water)\n","    print(\"Medicine Left :\", total_medicine)\n","\n","\n","# =========================\n","# AUTO RUN (IMPORTANT)\n","# =========================\n","print(\"\\nRunning CO3...\\n\")\n","\n","try:\n","    allocate_resources(sorted_areas)\n","except NameError:\n","    print(\"ERROR: Please run CO1 and CO2 first in order\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"q0RNzLMrpWkE","executionInfo":{"status":"ok","timestamp":1780123916352,"user_tz":-330,"elapsed":10966,"user":{"displayName":"Suggula Sri Vishnupriya","userId":"18192729581112984130"}},"outputId":"938f0a4d-9220-4098-c989-3c433f5ad71c"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Running CO3...\n","\n","\n","==============================\n","CO3 - RESOURCE ALLOCATION\n","==============================\n","\n","Enter Total Food Available: 1000\n","Enter Total Water Available: 20000\n","Enter Total Medicine Available: 300000\n","\n","--- Starting Allocation Process ---\n","\n","\n","Allocating resources to: 1234\n","Food Allocated     : 1000\n","Water Allocated    : 0\n","Medicine Allocated : 0\n","----------------------------------\n","\n","==============================\n","FINAL REMAINING RESOURCES\n","==============================\n","Food Left     : 0\n","Water Left    : 20000\n","Medicine Left : 300000\n"]}]}]}